# Copy to supabase/functions/.env for local `supabase functions serve`
# (that shared path -- not this file -- is what the CLI actually reads;
# see ROADMAP.md 4.1). Never commit the real .env -- it is gitignored by
# the root .gitignore's blanket `.env` / `.env.*` pattern.
#
# For the hosted project, set this as a Supabase secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# SUPABASE_URL and SUPABASE_ANON_KEY are provided automatically by the
# Supabase platform/CLI at runtime and must NOT be set here.

ANTHROPIC_API_KEY=sk-ant-...
